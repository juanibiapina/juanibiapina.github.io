---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { getReadingTime } from "@/utils/getReadingTime";
import { getPostDate } from "@/utils/getPostDate";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  id,
  body,
  data,
  filePath,
} = Astro.props;

const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone: postTimezone,
} = data;

const readingTime = body ? getReadingTime(body) : undefined;

const { iso, label } = getPostDate({
  pubDatetime,
  modDatetime,
  timezone: postTimezone,
});
---

<li class="list-none">
  <a
    href={getPath(id, filePath)}
    class="block border border-border px-5 pt-5 pb-4 no-underline transition-colors duration-200 hover:border-border-hover"
  >
    <span class="mb-1.5 block text-xs tracking-wider text-muted-foreground">
      <time datetime={iso}>{label}</time>
      {readingTime && <span> · {readingTime} min</span>}
    </span>
    <Heading class="mb-1.5 text-base leading-snug font-bold text-link">
      {title}
    </Heading>
    {description && <p class="leading-normal">{description}</p>}
  </a>
</li>
