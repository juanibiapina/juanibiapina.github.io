---
import { getPostDate } from "@/utils/getPostDate";

type Props = {
  class?: string;
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  readingTime?: number;
};

const {
  pubDatetime,
  modDatetime,
  class: className = "",
  timezone: postTimezone,
  readingTime,
} = Astro.props;

const { isModified, iso, label } = getPostDate({
  pubDatetime,
  modDatetime,
  timezone: postTimezone,
});
---

<div class:list={["flex items-center gap-x-2 opacity-75", className]}>
  {
    isModified && (
      <span class="text-sm">Updated:</span>
    )
  }
  <span class="text-sm">
    <time datetime={iso}>{label}</time>
    {readingTime && <span> · {readingTime} min read</span>}
  </span>
</div>
